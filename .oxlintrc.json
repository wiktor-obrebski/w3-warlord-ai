{
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["describe", "it"]
          }
        ]
      }
    ],
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@lib/warcraft3-api/*",
                  "!@lib/warcraft3-api/human",
                  "!@lib/warcraft3-api/neutral",
                  "!@lib/warcraft3-api/nightelf",
                  "!@lib/warcraft3-api/orc",
                  "!@lib/warcraft3-api/undead"
                ],
                "message": "Only the shell, privileged code, and main.ts touch Warcraft; the mind gets what it needs from Perception, the order executor, or the probes. The race modules' rawcodes are compile-time constants and stay allowed."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shell/**", "src/privileged/**", "src/main.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
