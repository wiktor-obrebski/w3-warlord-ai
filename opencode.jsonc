{
  "$schema": "https://opencode.ai/config.json",
  "model": "claude-code/claude-opus-5-5[1m]",
  "autoupdate": false,
  "agents": {
    "everyday": {
      "mode": "all",
      "description": "Use for everyday implementation, debugging, and changes requiring moderate reasoning.",
      "model": "claude-code/claude-opus-5-5[1m]"
    },
    "expert": {
      "mode": "all",
      "description": "Use only for the most complicated changes, especially architectural pivots, cross-cutting design, and unclear bugs after failed attempts.",
      "model": "claude-code/claude-opus-5-5[1m]#xhigh"
    },
    "simple": {
      "mode": "all",
      "description": "Use for tasks that are quite obvious to do, such as the simplest features and straightforward edits.",
      "model": "claude-code/claude-sonnet-5-5"
    },
    "refactor": {
      "mode": "all",
      "description": "Use for refactors and other simplest technical changes: renames, formatting, boilerplate, and mechanical edits.",
      "model": "claude-code/claude-haiku-5-5"
    }
  }
}
