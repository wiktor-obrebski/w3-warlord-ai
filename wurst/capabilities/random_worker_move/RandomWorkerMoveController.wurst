package RandomWorkerMoveController
import NoWurst
import MoveAction
import Wc3Perception
import Wc3ActionExecutor

tuple MoveActionResult(bool found, MoveAction action)

function chooseMoveAction(UnitRef worker) returns MoveActionResult
    let origin = getUnitPosition(worker)
    var attempt = 0
    while attempt < 10
        let direction = GetRandomReal(0., 6.283185307)
        let destination = Position(
            origin.x + 100. * Cos(direction),
            origin.y + 100. * Sin(direction)
        )
        if isTerrainWalkable(destination)
            return MoveActionResult(true, MoveAction(worker, destination))
        attempt++
    return MoveActionResult(false, MoveAction(worker, origin))

public function runRandomWorkerMove()
    let workers = getOwnWorkers()
    var nextWorker = workers.next()
    while nextWorker.found
        let result = chooseMoveAction(nextWorker.worker)
        if result.found
            executeMoveAction(result.action)
        nextWorker = workers.next()
    workers.close()
