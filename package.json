{
  "name": "w3-warlord-ai",
  "private": true,
  "workspaces": [
    "./lib/*"
  ],
  "scripts": {
    "bundle": "./bin/bundle.sh",
    "lint": "oxlint . && npm run format:check",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tstl --noEmit && tsc -p lib/logger/tsconfig.json",
    "test": "node --require ts-node/register/transpile-only --test \"lib/**/*.test.ts\"",
    "bench:node": "node --require ts-node/register/transpile-only lib/logger/benchmarks/node-benchmark.ts",
    "bench:lua": "tstl -p tsconfig.lua-harness.json --outDir _build/lua-harness --luaBundle logger-benchmark.lua --luaBundleEntry lib/logger/benchmarks/lua-benchmark.ts && lua _build/lua-harness/logger-benchmark.lua",
    "collect-logs": "node --require ts-node/register/transpile-only lib/logger/collector/collect-logs.ts",
    "build-map": "./bin/build-map/build-map.sh"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-to-lua": "^1.37.1"
  }
}
