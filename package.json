{
  "name": "w3-warlord-ai",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "./lib/*"
  ],
  "scripts": {
    "bundle": "./bin/bundle.sh",
    "lint": "oxlint . && npm run format:check",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tstl --noEmit && npm run typecheck --workspaces --if-present && tsc -p bin/collect-logs/tsconfig.json",
    "test": "npm test --workspaces --if-present && node --test \"bin/**/*.test.ts\"",
    "collect-logs": "node bin/collect-logs/collect-logs.ts",
    "build-map": "./bin/build-map/build-map.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-to-lua": "^1.37.1"
  }
}
