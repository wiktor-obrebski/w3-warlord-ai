{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  "tstl": {
    "luaPlugins": [
      {
        "name": "../warcraft-tstl-plugin/warcraft-tstl-plugin.ts"
      }
    ]
  },
  "include": [
    "*.ts",
    "core/*.ts",
    "json/*.ts",
    "preload/*.ts",
    "tests/support/*.ts",
    "tests/lua/*.ts",
    "benchmarks/logger-benchmarks.ts",
    "benchmarks/lua-benchmark.ts"
  ],
  "exclude": []
}
