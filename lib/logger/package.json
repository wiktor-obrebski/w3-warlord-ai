{
  "name": "@lib/logger",
  "private": true,
  "main": "./logger.ts",
  "types": "./logger.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tstl -p tsconfig.lua.json --noEmit",
    "test": "node --require ts-node/register/transpile-only --test \"tests/**/*.test.ts\"",
    "bench:node": "node --require ts-node/register/transpile-only benchmarks/node-benchmark.ts",
    "bench:lua": "tstl -p tsconfig.lua.json --outDir _build --luaBundle logger-benchmark.lua --luaBundleEntry benchmarks/lua-benchmark.ts && lua _build/logger-benchmark.lua"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-to-lua": "^1.37.1"
  }
}
