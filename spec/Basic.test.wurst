package BasicSpec
import NoWurst
import Spec
import StdLib_Core

class TestReference implements Stringifiable
    override function toString() returns string
        return "TestReference#" + I2S(this castTo int)

@test function oneEqualsOne()
    assertEquals(1, 1)

@test function equalReferencesAreEqual()
    let reference = new TestReference()
    assertEquals(reference, reference)
    destroy reference

@test function differentReferencesAreNotEqual()
    let reference = new TestReference()
    let reference2 = new TestReference()
    assertNotEquals(reference, reference2)
    destroy reference
